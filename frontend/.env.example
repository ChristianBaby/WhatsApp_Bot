# URL publica del Api_gateway del ecosistema Ruwark. El panel habla con el
# backend y con el login SIEMPRE a traves de ahi, nunca directo.
# Desarrollo: el Gateway corre en :8080 por defecto (ver Api_gateway/.env).
# Produccion: la URL publica real donde quede desplegado el Gateway.
VITE_GATEWAY_URL=http://localhost:8080
