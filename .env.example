# ============================================================
#  Bot de WhatsApp — Universoft Systems
#  Copia este archivo a .env y completa los valores.
#  NUNCA subas el .env al repositorio.
# ============================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3000
# URL pública del panel (se usa para armar la URL del webhook de leads)
APP_URL=http://localhost:3000
# El horario laboral de las publicaciones (seccion 3.5) se compara contra
# la hora local del servidor. Ajusta esto si el negocio no esta en Peru.
TZ=America/Lima

# --- Base de datos PostgreSQL ---
POSTGRES_USER=whatsapp_bot
POSTGRES_PASSWORD=cambiame_en_produccion
POSTGRES_DB=whatsapp_bot
# "localhost" al desarrollar en Windows; docker-compose lo cambia a "postgres"
# automaticamente cuando la app corre dentro de un contenedor.
POSTGRES_HOST=localhost
# 5433 al desarrollar en Windows (evita chocar con un Postgres ya instalado);
# dentro de docker-compose la app usa el 5432 de la red interna.
POSTGRES_PORT=5433

# --- Identidad (ecosistema Ruwark: micro_login + Api_gateway) ---
# El panel ya no maneja su propio usuario/contraseña — lo hace micro_login,
# a traves de Api_gateway. Este valor debe ser EXACTAMENTE el mismo
# MICROSERVICE_TOKEN configurado en Api_gateway (ver su .env): con eso el
# backend confirma que un request a /api/* vino realmente del Gateway y no
# directo de internet. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MICROSERVICE_TOKEN=cambiame_por_un_valor_aleatorio_largo

# URL publica del Api_gateway. Se usa al COMPILAR el panel (no en runtime):
# en Coolify debe estar marcada como "Build Variable". Sin ella el panel
# queda apuntando a localhost y el navegador no llega al login.
VITE_GATEWAY_URL=http://localhost:8080

# --- IA: clasificación de respuestas y auto-responder (Fase 5) ---
# Capa gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Rutas de datos persistentes ---
AUTH_SESSIONS_PATH=./auth_sessions
UPLOADS_PATH=./uploads

# --- Nivel de log: trace | debug | info | warn | error ---
LOG_LEVEL=info
